#!/usr/bin/python3
"""Task-owned SSH multiplexing; credentials remain in the existing private agent."""
import hashlib
import concurrent.futures
import json
import os
import pathlib
import re
import selectors
import socket
import subprocess
import sys
import threading
import time
import tempfile
import stat
import tomllib

ROOT = pathlib.Path(os.environ['ZEROCLAW_SSH_STATE_DIR']) if 'ZEROCLAW_SSH_STATE_DIR' in os.environ else pathlib.Path(os.environ.get('XDG_RUNTIME_DIR', tempfile.gettempdir())) / ('zeroclaw-ssh-' + str(os.getuid()) if hasattr(os, 'getuid') else 'zeroclaw-ssh')
SSH = '/usr/bin/ssh'
IDLE_SECONDS = 1800
SAFE_OPTIONS = {'batchmode', 'connecttimeout', 'loglevel'}


def parse_args(args):
    """Keep the service's identity, trust and multiplexing options authoritative."""
    options = []
    while args and args[0].startswith('-'):
        flag = args.pop(0)
        if flag == '--':
            break
        if flag not in ('-o', '-p', '-l') or not args:
            raise ValueError('Unsupported SSH option; use configured host aliases')
        value = args.pop(0)
        if flag == '-o' and value.split('=', 1)[0].lower() not in SAFE_OPTIONS:
            raise ValueError('SSH identity, trust and transport options cannot be overridden')
        options.extend((flag, value))
    if not args or not re.fullmatch(r'[a-zA-Z0-9_.:@\[\]-]+', args[0]):
        raise ValueError('A configured SSH host alias is required')
    host = args.pop(0)
    if not args:
        raise ValueError('An explicit noninteractive remote command is required')
    return options, host, args


def ssh_config(options, host, include_target=False):
    p = subprocess.run([SSH, '-G', *options, host], check=True,
                       capture_output=True, text=True, timeout=10)
    config = {}
    for line in p.stdout.splitlines():
        if ' ' in line:
            name, value = line.split(' ', 1)
            config.setdefault(name, []).append(value)
    # Keep aliases separate and bind reuse to every effective setting, including
    # host-key policy/files, certificates and proxy/authentication configuration.
    key = (host, sorted(config.items()))
    digest = hashlib.sha256(json.dumps(key).encode()).hexdigest()[:24]
    if include_target:
        return digest, {field: config[field][0] for field in ('hostname', 'port', 'user')}
    return digest


def scoped_record(alias, target):
    if not re.fullmatch(r'[A-Za-z0-9_-]{1,64}', alias):
        raise ValueError('Invalid SSH credential alias')
    root = pathlib.Path(os.environ['ZEROCLAW_SSH_CREDENTIAL_DIR'])
    config = tomllib.loads((root / 'config.toml').read_text())
    stored = config.get('http_request', {}).get('scoped_credentials', {}).get(alias, '')
    if not config.get('secrets', {}).get('encrypt', True) or not stored.startswith('enc2:'):
        raise ValueError('SSH credential unavailable')
    from cryptography.hazmat.primitives.ciphers.aead import ChaCha20Poly1305
    blob = bytes.fromhex(stored[5:])
    master = bytes.fromhex((root / '.secret_key').read_text().strip())
    record = json.loads(ChaCha20Poly1305(master).decrypt(blob[:12], blob[12:], None))
    auth = record['auth']
    if auth.get('kind') != 'ssh_key' or not any(
        grant['host'].lower() == target['hostname'].lower()
        and str(grant['port']) == target['port']
        and grant['username'] == target['user']
        for grant in auth.get('destinations', [])
    ):
        raise ValueError('SSH credential is not authorized for this destination')
    revision = hashlib.sha256(stored.encode()).hexdigest()
    return revision, record.get('source', 'local'), auth['private_key']


def start_scoped_agent(path, source, value):
    if source == 'open_bao':
        fields = value.split('/')
        if len(fields) < 3 or not all(re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.-]*', field) for field in fields):
            raise ValueError('Invalid OpenBao SSH key reference')
        fetched = subprocess.run(
            ['bao', 'kv', 'get', '-mount=' + fields[0], '-field=' + fields[-1], '/'.join(fields[1:-1])],
            capture_output=True, timeout=12, check=False,
        )
        if fetched.returncode or len(fetched.stdout) > 16384:
            raise ValueError('OpenBao SSH key lookup failed')
        value = fetched.stdout.decode('utf-8')
    elif source != 'local':
        raise ValueError('SSH credential source is unsupported by this helper')
    private = (value.rstrip() + '\n').encode()
    if len(private) > 16384 or not private.startswith(b'-----BEGIN OPENSSH PRIVATE KEY-----'):
        raise ValueError('Invalid OpenSSH private key')
    agent = subprocess.Popen(
        ['/usr/bin/setpriv', '--pdeathsig', 'TERM', '/usr/bin/ssh-agent', '-D', '-a', str(path)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    try:
        deadline = time.monotonic() + 3
        while not path.is_socket() and agent.poll() is None and time.monotonic() < deadline:
            time.sleep(0.03)
        loaded = subprocess.run(
            ['/usr/bin/ssh-add', '-'], input=private, timeout=6,
            env=dict(os.environ, SSH_AUTH_SOCK=str(path), SSH_ASKPASS_REQUIRE='never'),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if loaded.returncode:
            raise ValueError('Private SSH agent rejected the key')
        return agent
    except BaseException:
        stop_agent(agent, path)
        raise


def stop_agent(agent, path):
    if agent.poll() is None:
        agent.terminate()
        try:
            agent.wait(timeout=3)
        except subprocess.TimeoutExpired:
            agent.kill()
            agent.wait(timeout=3)
    path.unlink(missing_ok=True)


class BoundedLog:
    """Drain stderr continuously without an unbounded file or pipe backlog."""
    LIMIT = 8192

    def __init__(self):
        self.data = bytearray()
        self.lock = threading.Lock()
        self.closed = False
        self.reader = None

    def attach(self, stream):
        def drain():
            try:
                while chunk := stream.read(4096):
                    with self.lock:
                        if not self.closed:
                            self.data.extend(chunk)
                            del self.data[:-self.LIMIT]
            finally:
                stream.close()
        self.reader = threading.Thread(target=drain, daemon=True)
        self.reader.start()

    def detail(self):
        with self.lock:
            return bytes(self.data[-2048:]).decode(errors='replace').strip()

    def close(self):
        if self.reader:
            self.reader.join(timeout=3)
        with self.lock:
            self.closed = True
            self.data.clear()


class Pool:
    def __init__(self, directory, idle=IDLE_SECONDS, ssh=SSH, clock=time.monotonic):
        self.directory, self.idle, self.ssh, self.clock = directory, idle, ssh, clock
        self.entries = {}
        self.lock = threading.Lock()
        self.closed = False
        # Linux parent-death signals follow the creating thread, not only its
        # process. Use a task-lifetime thread, never a short client handler.
        self.spawner = concurrent.futures.ThreadPoolExecutor(max_workers=1)

    def acquire(self, key, options, host, credential=None):
        with self.lock:
            if self.closed:
                raise RuntimeError('SSH task has ended')
            entry = self.entries.get(key)
            owner = entry is None
            if owner:
                path = str(self.directory / key)
                command = ['/usr/bin/setpriv', '--pdeathsig', 'TERM', self.ssh, '-M', '-N', '-S', path,
                           '-o', 'ControlMaster=yes', '-o', 'ControlPersist=no',
                           '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=12',
                           '-o', 'ConnectionAttempts=1', '-o', 'ForwardAgent=no',
                           '-o', 'ServerAliveInterval=30', '-o', 'ServerAliveCountMax=3',
                           *options, host]
                if credential:
                    command[4:4] = ['-o', 'StrictHostKeyChecking=yes', '-o', 'IdentityAgent=' + str(self.directory / (key[:12] + '.agent')), '-o', 'IdentitiesOnly=no', '-o', 'IdentityFile=none',
                                    '-o', 'PreferredAuthentications=publickey']
                log = BoundedLog()
                agent_path = self.directory / (key[:12] + '.agent')
                def spawn():
                    agent = start_scoped_agent(agent_path, *credential) if credential else None
                    try:
                        process = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                                   stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
                    except BaseException:
                        if agent:
                            stop_agent(agent, agent_path)
                        raise
                    log.attach(process.stderr)
                    return process, agent
                entry = dict(key=key, process=None, agent_path=agent_path, future=self.spawner.submit(spawn), path=path,
                             host=host, log=log, active=0, last=self.clock(), failed=False,
                             ready=threading.Event(), stop_lock=threading.Lock(), agent_lock=threading.Lock())
                self.entries[key] = entry
        # Only callers of this key wait for its setup. Other destinations and
        # task shutdown never wait behind its network connection deadline.
        if owner:
            try:
                process, agent = entry['future'].result()
                entry['process'] = process
                deadline = time.monotonic() + 15
                while not pathlib.Path(entry['path']).exists() and process.poll() is None:
                    if self.closed or time.monotonic() > deadline:
                        break
                    time.sleep(0.05)
                # OpenSSH creates its multiplex listener after authentication.
                # Remove signing capability before making the connection available.
                if agent is not None:
                    self.retire_agent(entry, agent)
                with self.lock:
                    entry['last'] = self.clock()
                    entry['failed'] = (self.closed or not pathlib.Path(entry['path']).exists()
                                       or process.poll() is not None)
            except Exception:
                with self.lock:
                    entry['failed'] = True
            finally:
                entry['ready'].set()
            if entry['failed']:
                detail = entry['log'].detail()
                self.stop(entry)
                raise RuntimeError('SSH connection failed; not retried in this task: ' + detail)
        else:
            if not entry['ready'].wait(timeout=18):
                raise RuntimeError('SSH connection setup did not complete')
        with self.lock:
            if self.closed:
                raise RuntimeError('SSH task has ended')
            # Expiry may have retired this entry after ready.wait returned.
            # Validate its generation under the same lock as the active lease.
            if self.entries.get(key) is entry and not entry.get('retired'):
                if entry['failed'] or entry['process'] is None or entry['process'].poll() is not None:
                    entry['failed'] = True
                    raise RuntimeError('SSH transport unavailable; diagnose before starting a new task')
                entry['active'] += 1
                entry['last'] = self.clock()
                return entry['path']
        return self.acquire(key, options, host, credential)

    def release(self, key):
        with self.lock:
            if key in self.entries:
                entry = self.entries[key]
                entry['active'] = max(0, entry['active'] - 1)
                entry['last'] = self.clock()

    @staticmethod
    def retire_agent(entry, agent):
        with entry['agent_lock']:
            if not entry.get('agent_retired'):
                stop_agent(agent, entry['agent_path'])
                entry['agent_retired'] = True

    @staticmethod
    def stop(entry):
        with entry['stop_lock']:
            try:
                process, agent = entry['future'].result()
            except Exception:
                process, agent = None, None
            if process is not None and process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=3)
            if agent:
                Pool.retire_agent(entry, agent)
            entry['log'].close()
            pathlib.Path(entry['path']).unlink(missing_ok=True)

    def expire(self):
        expired = []
        with self.lock:
            for key, entry in list(self.entries.items()):
                if not entry['ready'].is_set():
                    continue
                if entry['failed'] or entry['process'] is None or entry['process'].poll() is not None:
                    entry['failed'] = True
                    expired.append(entry)
                elif not entry['active'] and self.clock() - entry['last'] >= self.idle:
                    entry['retired'] = True
                    entry['ready'].clear()
                    expired.append(entry)
        for entry in expired:
            self.stop(entry)
            if entry.get('retired'):
                with self.lock:
                    if self.entries.get(entry['key']) is entry:
                        del self.entries[entry['key']]
                entry['ready'].set()

    def close(self):
        with self.lock:
            self.closed = True
            entries = list(self.entries.values())
            self.entries.clear()
        for entry in entries:
            self.stop(entry)
        self.spawner.shutdown(wait=True)


def read_message(peer):
    data = bytearray()
    while not data.endswith(b'\n'):
        part = peer.recv(4096)
        if not part:
            raise EOFError('SSH client disconnected')
        data.extend(part)
        if len(data) > 16384:
            raise ValueError('SSH request too large')
    return json.loads(data)


def serve(directory):
    os.umask(0o077)
    ROOT.mkdir(mode=0o700, exist_ok=True)
    info = ROOT.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError('SSH state directory must be private and owned by the service user')
    directory.mkdir(mode=0o700)
    listener = socket.socket(socket.AF_UNIX)
    listener.bind(str(directory / 'broker'))
    listener.listen(32)
    idle = int(os.environ.get('ZEROCLAW_SSH_IDLE_TIMEOUT_SECS', str(IDLE_SECONDS)))
    if not 1 <= idle <= 86400:
        raise ValueError('SSH idle timeout must be between 1 and 86400 seconds')
    pool = Pool(directory, idle=idle)
    selector = selectors.DefaultSelector()
    selector.register(listener, selectors.EVENT_READ)
    # The turn owner holds stdin. EOF closes all transports even on cancellation,
    # panic or daemon termination; this is independent of model-generated cleanup.
    selector.register(sys.stdin.buffer, selectors.EVENT_READ)
    (directory / 'ready').touch(mode=0o600)
    print(json.dumps({'ready': True, 'state_dir': str(ROOT)}), flush=True)

    def handle(peer):
        key = None
        acquired = False
        try:
            peer.settimeout(20)
            request = read_message(peer)
            options, host, _ = parse_args(list(request['argv']))
            alias = request.get('credential') or os.environ.get('ZEROCLAW_SSH_DEFAULT_CREDENTIAL')
            if alias:
                effective, target = ssh_config(options, host, include_target=True)
                try:
                    revision, source, value = scoped_record(alias, target)
                except ValueError as exc:
                    if str(exc) in ('SSH credential unavailable', 'SSH credential is not authorized for this destination'):
                        raise
                    raise ValueError('SSH credential lookup failed') from None
                except Exception:
                    raise ValueError('SSH credential lookup failed') from None
                key = hashlib.sha256(f'{effective}:{alias}:{revision}'.encode()).hexdigest()[:24]
                path = pool.acquire(key, options, host, (source, value))
            else:
                key = ssh_config(options, host)
                path = pool.acquire(key, options, host)
            acquired = True
            peer.sendall(json.dumps({'path': path}).encode() + b'\n')
            peer.settimeout(None)
            # Hold the lease only while the command's client is alive.
            while peer.recv(1):
                pass
        except Exception as exc:
            try:
                peer.sendall(json.dumps({'error': str(exc)}).encode() + b'\n')
            except OSError:
                pass
        finally:
            if acquired:
                pool.release(key)
            peer.close()

    try:
        while True:
            for event, _ in selector.select(timeout=1):
                if event.fileobj is listener:
                    peer, _ = listener.accept()
                    threading.Thread(target=handle, args=(peer,), daemon=True).start()
                elif not os.read(sys.stdin.fileno(), 1):
                    return
            pool.expire()
    finally:
        listener.close()
        pool.close()
        selector.close()
        for item in directory.iterdir():
            item.unlink(missing_ok=True)
        directory.rmdir()


def client(args):
    scope = os.environ.get('ZEROCLAW_SSH_TASK')
    if not scope or not re.fullmatch('[a-f0-9]{32}', scope):
        raise RuntimeError('SSH requires an active ZeroClaw task; no unmanaged fallback')
    credential = None
    if args[:1] == ['--credential']:
        if len(args) < 3:
            raise ValueError('SSH credential alias and destination are required')
        credential, args = args[1], args[2:]
    options, host, commands = parse_args(list(args))
    with socket.socket(socket.AF_UNIX) as peer:
        peer.settimeout(20)
        peer.connect(str(ROOT / scope / 'broker'))
        peer.sendall(json.dumps({'argv': args, 'credential': credential}).encode() + b'\n')
        response = read_message(peer)
        if 'error' in response:
            raise RuntimeError(response['error'])
        # Fail closed if the master disappears. Never fall back to a new TCP
        # connection, another identity, password authentication or trust bypass.
        return subprocess.call([SSH, '-S', response['path'],
                                '-o', 'ControlMaster=no', '-o', 'ControlPersist=no',
                                '-o', 'ProxyCommand=/usr/bin/false',
                                '-o', 'BatchMode=yes', '-o', 'ForwardAgent=no',
                                *options, '--', host, *commands])


if __name__ == '__main__':
    try:
        if len(sys.argv) == 3 and sys.argv[1] == '--serve':
            if not re.fullmatch('[a-f0-9]{32}', sys.argv[2]):
                raise ValueError('Invalid task identity')
            serve(ROOT / sys.argv[2])
        else:
            sys.exit(client(sys.argv[1:]))
    except Exception as exc:
        print('zeroclaw-ssh: ' + str(exc), file=sys.stderr)
        sys.exit(255)
